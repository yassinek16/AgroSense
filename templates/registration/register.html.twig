{% extends 'base.html.twig' %}

{% block title %}Inscription - Smart Greenhouse{% endblock %}

{% block body %}
<div class="container">
    <div class="row justify-content-center py-5">
        <div class="col-md-6">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-person-plus-fill text-success" style="font-size: 3rem;"></i>
                        <h2 class="mt-3 text-success">Créer un compte</h2>
                        <p class="text-muted">Rejoignez la communauté Smart Greenhouse</p>
                    </div>

                    {{ form_start(registrationForm, {'attr': {'novalidate': 'novalidate'}}) }}
                    {{ form_errors(registrationForm) }}
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                {{ form_label(registrationForm.firstName, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(registrationForm.firstName, {'attr': {
                                    'class': 'form-control',
                                    'placeholder': 'Jean'
                                }}) }}
                                {{ form_errors(registrationForm.firstName) }}
                            </div>

                            <div class="col-md-6 mb-3">
                                {{ form_label(registrationForm.lastName, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(registrationForm.lastName, {'attr': {
                                    'class': 'form-control',
                                    'placeholder': 'Dupont'
                                }}) }}
                                {{ form_errors(registrationForm.lastName) }}
                            </div>
                        </div>

                        <div class="mb-3">
                            {{ form_label(registrationForm.email, null, {'label_attr': {'class': 'form-label'}}) }}
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                {{ form_widget(registrationForm.email, {'attr': {
                                    'class': 'form-control',
                                    'placeholder': 'votre@email.com'
                                }}) }}
                            </div>
                            {{ form_errors(registrationForm.email) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(registrationForm.phone, null, {'label_attr': {'class': 'form-label'}}) }}
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-phone"></i></span>
                                {{ form_widget(registrationForm.phone, {'attr': {
                                    'class': 'form-control',
                                    'placeholder': '+216 XX XXX XXX'
                                }}) }}
                            </div>
                            {{ form_errors(registrationForm.phone) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(registrationForm.plainPassword, null, {'label_attr': {'class': 'form-label'}}) }}
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                {{ form_widget(registrationForm.plainPassword, {'attr': {
                                    'class': 'form-control',
                                    'placeholder': 'Minimum 6 caractères'
                                }}) }}
                            </div>
                            {{ form_errors(registrationForm.plainPassword) }}
                            <div class="form-text">
                                <i class="bi bi-info-circle"></i> Utilisez au moins 6 caractères avec lettres et chiffres
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="form-check">
                                {{ form_widget(registrationForm.agreeTerms) }}
                                {{ form_label(registrationForm.agreeTerms) }}
                            </div>
                            {{ form_errors(registrationForm.agreeTerms) }}
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-check-circle"></i> S'inscrire
                            </button>
                        </div>

                        <hr class="my-4">

                        <div class="text-center">
                            <p class="text-muted mb-2">Vous avez déjà un compte ?</p>
                            <a href="{{ path('app_login') }}" class="btn btn-outline-primary">
                                <i class="bi bi-box-arrow-in-right"></i> Se connecter
                            </a>
                        </div>

                    {{ form_end(registrationForm) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
