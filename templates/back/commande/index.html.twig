{% extends 'back/back_base.html.twig' %}

{% block title %}Gestion des Commandes{% endblock %}

{% block page_title %}Gestion des Commandes{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">Liste des commandes</h4>
        <p class="text-muted mb-0">Consultez et gérez les commandes passées par vos clients</p>
    </div>
    <div class="d-flex gap-2">
        <div class="input-group" style="width: 300px;">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control" placeholder="Rechercher une référence..." id="searchInput">
        </div>
        <div class="input-group" style="width: 200px;">
            <span class="input-group-text"><i class="bi bi-funnel"></i></span>
            <select class="form-select" id="statusFilter">
                <option value="all">Tous</option>
                <option value="Confirmée">Confirmées</option>
                <option value="En attente">En attente</option>
                <option value="Annulée">Annulées</option>
            </select>
        </div>
    </div>
</div>

<!-- Filtres et Recherche -->
<div class="card mb-4">
    <div class="card-body">
        <form method="GET" class="row g-3">
            <div class="col-md-4">
                <label for="search" class="form-label">Recherche</label>
                <input type="text" 
                       id="search" 
                       name="search" 
                       value="{{ search }}" 
                       class="form-control" 
                       placeholder="Rechercher par référence ou statut...">
            </div>
            
            <div class="col-md-3">
                <label for="status" class="form-label">Filtre Statut</label>
                <select id="status" name="status" class="form-select">
                    <option value="all" {{ statusFilter == 'all' ? 'selected' : '' }}>Tous</option>
                    <option value="Confirmée" {{ statusFilter == 'Confirmée' ? 'selected' : '' }}>Confirmées</option>
                    <option value="En attente" {{ statusFilter == 'En attente' ? 'selected' : '' }}>En attente</option>
                    <option value="Annulée" {{ statusFilter == 'Annulée' ? 'selected' : '' }}>Annulées</option>
                </select>
            </div>
            
            <div class="col-md-3">
                <label for="sort" class="form-label">Trier par</label>
                <select id="sort" name="sort" class="form-select">
                    <option value="id" {{ sortBy == 'id' ? 'selected' : '' }}>ID</option>
                    <option value="reference" {{ sortBy == 'reference' ? 'selected' : '' }}>Référence</option>
                    <option value="dateCommande" {{ sortBy == 'dateCommande' ? 'selected' : '' }}>Date</option>
                    <option value="total" {{ sortBy == 'total' ? 'selected' : '' }}>Total</option>
                    <option value="statut" {{ sortBy == 'statut' ? 'selected' : '' }}>Statut</option>
                </select>
            </div>
            
            <div class="col-md-2">
                <label for="order" class="form-label">Ordre</label>
                <select id="order" name="order" class="form-select">
                    <option value="asc" {{ order == 'asc' ? 'selected' : '' }}>Croissant</option>
                    <option value="desc" {{ order == 'desc' ? 'selected' : '' }}>Décroissant</option>
                </select>
            </div>
            
            <div class="col-md-1">
                <label class="form-label">&nbsp;</label>
                <button type="submit" class="btn btn-outline-primary w-100">
                    <i class="bi bi-funnel"></i> Filtrer
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        {% if commandes %}
            <div class="table-responsive">
                <table class="table table-hover" id="ordersTable">
                    <thead class="table-light">
                        <tr>
                            <th>
                                <a href="?{{ app.request.query.all|merge({'sort': 'reference'})|url_encode }}" class="text-decoration-none text-dark">
                                    Référence
                                    {% if sortBy == 'reference' %}
                                        <i class="bi bi-caret-{{ order == 'asc' ? 'up' : 'down' }} ms-1"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th>
                                <a href="?{{ app.request.query.all|merge({'sort': 'dateCommande'})|url_encode }}" class="text-decoration-none text-dark">
                                    Date
                                    {% if sortBy == 'dateCommande' %}
                                        <i class="bi bi-caret-{{ order == 'asc' ? 'up' : 'down' }} ms-1"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th>Nombre d'articles</th>
                            <th>
                                <a href="?{{ app.request.query.all|merge({'sort': 'total'})|url_encode }}" class="text-decoration-none text-dark">
                                    Total
                                    {% if sortBy == 'total' %}
                                        <i class="bi bi-caret-{{ order == 'asc' ? 'up' : 'down' }} ms-1"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for commande in commandes %}
                            <tr>
                                <td>
                                    <span class="badge bg-primary">{{ commande.reference }}</span>
                                </td>
                                <td>
                                    <div>
                                        <strong>{{ commande.dateCommande ? commande.dateCommande|date('d/m/Y') : '' }}</strong><br>
                                        <small class="text-muted">{{ commande.dateCommande ? commande.dateCommande|date('H:i') : '' }}</small>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-info">{{ commande.ligneCommandes|length }}</span>
                                </td>
                                <td>
                                    <span class="fw-bold text-success">{{ commande.total }} DT</span>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="{{ path('app_commande_show', {'id': commande.id}) }}" 
                                           class="btn btn-sm btn-outline-primary" title="Voir les détails">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <form action="{{ path('app_commande_delete', {'id': commande.id}) }}" 
                                              method="POST" 
                                              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette commande?')">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ commande.id) }}">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Supprimer">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            
            <!-- Statistics -->
            <div class="row mt-4">
                <div class="col-md-4">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h5 class="text-primary">{{ commandes|length }}</h5>
                            <small class="text-muted">Commandes totales</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h5 class="text-success">
                                {% set total = 0 %}
                                {% for commande in commandes %}
                                    {% set total = total + commande.total %}
                                {% endfor %}
                                {{ total }} DT
                            </h5>
                            <small class="text-muted">Chiffre d'affaires</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h5 class="text-info">
                                {% set totalItems = 0 %}
                                {% for commande in commandes %}
                                    {% set totalItems = totalItems + commande.ligneCommandes|length %}
                                {% endfor %}
                                {{ totalItems }}
                            </h5>
                            <small class="text-muted">Articles vendus</small>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="text-center py-5">
                <i class="bi bi-receipt" style="font-size: 4rem; color: #ccc;"></i>
                <h5 class="mt-3 text-muted">Aucune commande trouvée</h5>
                <p class="text-muted">Les commandes des clients apparaîtront ici.</p>
            </div>
        {% endif %}
    </div>
</div>

<script>
// Simple search functionality
document.getElementById('searchInput').addEventListener('input', function(e) {
    const searchTerm = e.target.value.toLowerCase();
    const rows = document.querySelectorAll('#ordersTable tbody tr');
    
    rows.forEach(row => {
        const reference = row.querySelector('td:first-child').textContent.toLowerCase();
        if (reference.includes(searchTerm)) {
            row.style.display = '';
        } else {
            row.style.display = 'none';
        }
    });
});
</script>
{% endblock %}
