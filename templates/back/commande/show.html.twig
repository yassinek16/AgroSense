{% extends 'back/back_base.html.twig' %}

{% block title %}Détails de la Commande{% endblock %}

{% block page_title %}Détails de la Commande{% endblock %}

{% block body %}
<div class="row">
    <div class="col-lg-8">
        <!-- Order Details -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-receipt me-2"></i>Commande {{ commande.reference }}
                </h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Référence:</strong>
                        <span class="badge bg-primary ms-2">{{ commande.reference }}</span>
                    </div>
                    <div class="col-md-6">
                        <strong>Date de commande:</strong>
                        {{ commande.dateCommande ? commande.dateCommande|date('d/m/Y H:i') : '' }}
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-md-6">
                        <strong>Total:</strong>
                        <span class="fw-bold text-success ms-2">{{ commande.total }} DT</span>
                    </div>
                    <div class="col-md-6">
                        <strong>Nombre d'articles:</strong>
                        <span class="badge bg-info ms-2">{{ commande.ligneCommandes|length }}</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Items -->
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="bi bi-list-ul me-2"></i>Articles commandés
                </h6>
            </div>
            <div class="card-body">
                {% if commande.ligneCommandes is not empty %}
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead class="table-light">
                                <tr>
                                    <th>Produit</th>
                                    <th class="text-center">Quantité</th>
                                    <th class="text-end">Prix unitaire</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for ligne in commande.ligneCommandes %}
                                    <tr>
                                        <td>
                                            <strong>{{ ligne.produit.nom }}</strong>
                                            {% if ligne.produit.image %}
                                                <br><small class="text-muted">Avec image</small>
                                            {% endif %}
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-secondary">{{ ligne.quantite }}</span>
                                        </td>
                                        <td class="text-end">{{ ligne.prixUnitaire }} DT</td>
                                        <td class="text-end fw-bold">{{ ligne.quantite * ligne.prixUnitaire }} DT</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <th colspan="3" class="text-end">Total de la commande:</th>
                                    <th class="text-end text-success">{{ commande.total }} DT</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                {% else %}
                    <p class="text-muted">Aucun article dans cette commande.</p>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <!-- Actions -->
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="bi bi-gear me-2"></i>Actions
                </h6>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="{{ path('app_commande_index') }}" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-2"></i>Retour à la liste
                    </a>
                    
                    <div class="border-top pt-2">
                        <form action="{{ path('app_commande_delete', {'id': commande.id}) }}" 
                              method="POST" 
                              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette commande?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ commande.id) }}">
                            <button type="submit" class="btn btn-outline-danger w-100">
                                <i class="bi bi-trash me-2"></i>Supprimer
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Info -->
        <div class="card mt-3">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="bi bi-info-circle me-2"></i>Informations
                </h6>
            </div>
            <div class="card-body">
                <div class="small">
                    <div class="mb-2">
                        <strong>ID Commande:</strong><br>
                        <span class="text-muted">#{{ commande.id }}</span>
                    </div>
                    <div class="mb-2">
                        <strong>Date de création:</strong><br>
                        <span class="text-muted">{{ commande.createdAt ? commande.createdAt|date('d/m/Y H:i') : '' }}</span>
                    </div>
                    <div>
                        <strong>Statut:</strong><br>
                        <span class="badge bg-success">Confirmée</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
