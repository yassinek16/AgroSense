{{ form_start(form) }}
<div class="row">
    <div class="col-md-6 mb-3">
        {{ form_label(form.reference, 'Référence', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.reference, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.reference) }}
    </div>
    <div class="col-md-6 mb-3">
        {{ form_label(form.dateCommande, 'Date de commande', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.dateCommande, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.dateCommande) }}
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        {{ form_label(form.statut, 'Statut', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.statut, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.statut) }}
        <small class="form-text text-muted">
            Statuts disponibles: En attente, Confirmée, Expédiée, Livrée, Annulée
        </small>
    </div>
    <div class="col-md-6 mb-3">
        {{ form_label(form.total, 'Total (DT)', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.total, {'attr': {'class': 'form-control', 'step': '0.01', 'min': '0', 'max': '99999.99', 'placeholder': '0.00'}}) }}
        {{ form_errors(form.total) }}
        <small class="form-text text-muted">
            Le total doit être un nombre positif inférieur à 100 000 DT
        </small>
    </div>
</div>

<div class="d-flex justify-content-between">
    <a href="{{ path('app_commande_index') }}" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-2"></i>Retour à la liste
    </a>
    <button type="submit" class="btn btn-primary">
        <i class="bi bi-check-circle me-2"></i>{{ button_label|default('Mettre à jour') }}
    </button>
</div>
{{ form_end(form) }}
