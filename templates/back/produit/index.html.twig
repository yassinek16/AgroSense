{% extends 'back/back_base.html.twig' %}

{% block title %}Gestion des Produits{% endblock %}

{% block page_title %}Gestion des Produits{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">Liste des produits</h4>
        <p class="text-muted mb-0">Gérez votre catalogue de produits agricoles</p>
    </div>
    <a href="{{ path('app_produit_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-circle me-2"></i>Ajouter un produit
    </a>
</div>

<!-- Filtres et Recherche -->
<div class="card mb-4">
    <div class="card-body">
        <form method="GET" class="row g-3">
            <div class="col-md-4">
                <label for="search" class="form-label">Recherche</label>
                <input type="text" 
                       id="search" 
                       name="search" 
                       value="{{ search }}" 
                       class="form-control" 
                       placeholder="Rechercher par nom ou description...">
            </div>
            
            <div class="col-md-3">
                <label for="stock" class="form-label">Filtre Stock</label>
                <select id="stock" name="stock" class="form-select">
                    <option value="all" {{ stockFilter == 'all' ? 'selected' : '' }}>Tous</option>
                    <option value="available" {{ stockFilter == 'available' ? 'selected' : '' }}>Disponibles</option>
                    <option value="low" {{ stockFilter == 'low' ? 'selected' : '' }}>Stock faible</option>
                    <option value="out" {{ stockFilter == 'out' ? 'selected' : '' }}>Rupture</option>
                </select>
            </div>
            
            <div class="col-md-2">
                <label for="sort" class="form-label">Trier par</label>
                <select id="sort" name="sort" class="form-select">
                    <option value="id" {{ sortBy == 'id' ? 'selected' : '' }}>ID</option>
                    <option value="nom" {{ sortBy == 'nom' ? 'selected' : '' }}>Nom</option>
                    <option value="prix" {{ sortBy == 'prix' ? 'selected' : '' }}>Prix</option>
                    <option value="quantiteStock" {{ sortBy == 'quantiteStock' ? 'selected' : '' }}>Stock</option>
                    <option value="createdAt" {{ sortBy == 'createdAt' ? 'selected' : '' }}>Date</option>
                </select>
            </div>
            
            <div class="col-md-2">
                <label for="order" class="form-label">Ordre</label>
                <select id="order" name="order" class="form-select">
                    <option value="asc" {{ order == 'asc' ? 'selected' : '' }}>Croissant</option>
                    <option value="desc" {{ order == 'desc' ? 'selected' : '' }}>Décroissant</option>
                </select>
            </div>
            
            <div class="col-md-1">
                <label class="form-label">&nbsp;</label>
                <button type="submit" class="btn btn-outline-primary w-100">
                    <i class="bi bi-funnel"></i> Filtrer
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        {% if produits %}
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Image</th>
                            <th>
                                <a href="?{{ app.request.query.all|merge({'sort': 'nom'})|url_encode }}" class="text-decoration-none text-dark">
                                    Nom
                                    {% if sortBy == 'nom' %}
                                        <i class="bi bi-caret-{{ order == 'asc' ? 'up' : 'down' }} ms-1"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th>
                                <a href="?{{ app.request.query.all|merge({'sort': 'prix'})|url_encode }}" class="text-decoration-none text-dark">
                                    Prix
                                    {% if sortBy == 'prix' %}
                                        <i class="bi bi-caret-{{ order == 'asc' ? 'up' : 'down' }} ms-1"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th>
                                <a href="?{{ app.request.query.all|merge({'sort': 'quantiteStock'})|url_encode }}" class="text-decoration-none text-dark">
                                    Stock
                                    {% if sortBy == 'quantiteStock' %}
                                        <i class="bi bi-caret-{{ order == 'asc' ? 'up' : 'down' }} ms-1"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th>
                                <a href="?{{ app.request.query.all|merge({'sort': 'createdAt'})|url_encode }}" class="text-decoration-none text-dark">
                                    Date d'ajout
                                    {% if sortBy == 'createdAt' %}
                                        <i class="bi bi-caret-{{ order == 'asc' ? 'up' : 'down' }} ms-1"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for produit in produits %}
                            <tr>
                                <td>
                                    {% if produit.image %}
                                        <img src="{{ asset('uploads/images/' ~ produit.image) }}" 
                                             alt="{{ produit.nom }}"
                                             style="width: 50px; height: 50px; object-fit: cover; border-radius: 0.5rem;">
                                    {% else %}
                                        <div class="bg-light rounded d-flex align-items-center justify-content-center" 
                                             style="width: 50px; height: 50px;">
                                            <i class="bi bi-image text-muted"></i>
                                        </div>
                                    {% endif %}
                                </td>
                                <td>
                                    <strong>{{ produit.nom }}</strong>
                                    <br>
                                    <small class="text-muted">{{ produit.description|slice(0, 50) }}{% if produit.description|length > 50 %}...{% endif %}</small>
                                </td>
                                <td>
                                    <span class="fw-bold text-success">{{ produit.prix }} DT</span>
                                </td>
                                <td>
                                    {% if produit.quantiteStock > 10 %}
                                        <span class="badge bg-success">{{ produit.quantiteStock }}</span>
                                    {% elseif produit.quantiteStock > 0 %}
                                        <span class="badge bg-warning">{{ produit.quantiteStock }}</span>
                                    {% else %}
                                        <span class="badge bg-danger">{{ produit.quantiteStock }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <small class="text-muted">{{ produit.createdAt ? produit.createdAt|date('d/m/Y') : '' }}</small>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="{{ path('app_produit_show', {'id': produit.id}) }}" 
                                           class="btn btn-sm btn-outline-primary" 
                                           title="Voir">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="{{ path('app_produit_edit', {'id': produit.id}) }}" 
                                           class="btn btn-sm btn-outline-secondary" 
                                           title="Modifier">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form action="{{ path('app_produit_delete', {'id': produit.id}) }}" 
                                              method="POST" 
                                              style="display: inline-block;">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ produit.id) }}">
                                            <button type="submit" 
                                                    class="btn btn-sm btn-outline-danger" 
                                                    title="Supprimer"
                                                    onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce produit ?')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="text-center py-5">
                <i class="bi bi-inbox" style="font-size: 4rem; color: #ccc;"></i>
                <h5 class="mt-3 text-muted">Aucun produit trouvé</h5>
                <p class="text-muted">Commencez par ajouter votre premier produit.</p>
                <a href="{{ path('app_produit_new') }}" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-2"></i>Ajouter un produit
                </a>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
