{% extends 'back/back_base.html.twig' %}

{% block title %}Produit{% endblock %}

{% block page_title %}Détails du Produit{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-eye me-2"></i>{{ produit.nom }}
                </h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Image:</strong><br>
                        {% if produit.image %}
                            <img src="{{ asset('uploads/images/' ~ produit.image) }}" 
                                 alt="{{ produit.nom }}"
                                 style="max-height: 200px; border-radius: 0.5rem;">
                        {% else %}
                            <div class="bg-light rounded d-flex align-items-center justify-content-center" 
                                 style="height: 200px; width: 200px;">
                                <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
                            </div>
                        {% endif %}
                    </div>
                    <div class="col-md-6">
                        <strong>Informations:</strong><br>
                        <p><strong>ID:</strong> {{ produit.id }}</p>
                        <p><strong>Prix:</strong> <span class="text-success fw-bold">{{ produit.prix }} DT</span></p>
                        <p><strong>Stock:</strong> 
                            {% if produit.quantiteStock > 10 %}
                                <span class="badge bg-success">{{ produit.quantiteStock }}</span>
                            {% elseif produit.quantiteStock > 0 %}
                                <span class="badge bg-warning">{{ produit.quantiteStock }}</span>
                            {% else %}
                                <span class="badge bg-danger">Rupture</span>
                            {% endif %}
                        </p>
                        <p><strong>Date d'ajout:</strong> {{ produit.createdAt ? produit.createdAt|date('d/m/Y H:i') : '' }}</p>
                    </div>
                </div>
                
                <div class="mb-3">
                    <strong>Description:</strong><br>
                    <p class="text-muted">{{ produit.description }}</p>
                </div>
                
                <div class="d-flex justify-content-between">
                    <a href="{{ path('app_produit_index') }}" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-2"></i>Retour à la liste
                    </a>
                    <a href="{{ path('app_produit_edit', {'id': produit.id}) }}" class="btn btn-primary">
                        <i class="bi bi-pencil me-2"></i>Modifier
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
