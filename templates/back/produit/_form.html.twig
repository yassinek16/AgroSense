{# On ajoute 'novalidate' pour ignorer la validation par défaut du navigateur #}
{{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'needs-validation'}}) }}
    
    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                {{ form_label(form.nom, 'Nom du produit', {'label_attr': {'class': 'form-label'}}) }}
                {# On ajoute dynamiquement la classe 'is-invalid' si une erreur existe sur ce champ #}
                {{ form_widget(form.nom, {'attr': {'class': 'form-control' ~ (form.nom.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                {{ form_errors(form.nom) }}
                {% if form.nom.vars.help %}
                    <small class="form-text text-muted">{{ form.nom.vars.help }}</small>
                {% endif %}
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="mb-3">
                {{ form_label(form.prix, 'Prix (DT)', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.prix, {'attr': {'class': 'form-control' ~ (form.prix.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                {{ form_errors(form.prix) }}
                {% if form.prix.vars.help %}
                    <small class="form-text text-muted">{{ form.prix.vars.help }}</small>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                {{ form_label(form.quantiteStock, 'Quantité en stock', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.quantiteStock, {'attr': {'class': 'form-control' ~ (form.quantiteStock.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                {{ form_errors(form.quantiteStock) }}
                {% if form.quantiteStock.vars.help %}
                    <small class="form-text text-muted">{{ form.quantiteStock.vars.help }}</small>
                {% endif %}
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="mb-3">
                {{ form_label(form.imageFile, 'Image du produit', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.imageFile, {'attr': {'class': 'form-control' ~ (form.imageFile.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                {{ form_errors(form.imageFile) }}
                
                {% if produit.image %}
                    <div class="mt-2 p-2 border rounded bg-light text-center">
                        <small class="text-muted d-block mb-1">Image actuelle :</small>
                        <img src="{{ asset('uploads/images/' ~ produit.image) }}" 
                             alt="{{ produit.nom }}"
                             style="max-height: 80px; width: auto; border-radius: 4px;">
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="mb-4">
        {{ form_label(form.description, 'Description', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.description, {'attr': {'class': 'form-control' ~ (form.description.vars.errors|length > 0 ? ' is-invalid' : ''), 'rows': 4}}) }}
        {{ form_errors(form.description) }}
        {% if form.description.vars.help %}
            <small class="form-text text-muted">{{ form.description.vars.help }}</small>
        {% endif %}
    </div>

    <div class="d-flex justify-content-between align-items-center mt-4 border-top pt-3">
        <a href="{{ path('app_produit_index') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Retour à la liste
        </a>
        <button type="submit" class="btn btn-primary px-4">
            <i class="bi bi-check-circle me-2"></i>{{ button_label|default('Enregistrer') }}
        </button>
    </div>
{{ form_end(form) }}