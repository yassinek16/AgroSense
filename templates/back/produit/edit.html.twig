{% extends 'back/back_base.html.twig' %}

{% block title %}Modifier un Produit{% endblock %}

{% block page_title %}Modifier un Produit{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-pencil me-2"></i>Modifier: {{ produit.nom }}
                </h5>
            </div>
            <div class="card-body">
                {{ include('back/produit/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
            </div>
        </div>
        
        <div class="card mt-3 border-danger">
            <div class="card-header bg-danger text-white">
                <h6 class="mb-0">
                    <i class="bi bi-exclamation-triangle me-2"></i>Zone de danger
                </h6>
            </div>
            <div class="card-body">
                <p class="text-muted mb-3">
                    La suppression de ce produit est irréversible et supprimera également toutes les données associées.
                </p>
                {{ include('back/produit/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
