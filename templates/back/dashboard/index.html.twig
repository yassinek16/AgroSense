{% extends 'back/back_base.html.twig' %}

{% block title %}Tableau de Bord{% endblock %}

{% block page_title %}Tableau de Bord - Statistiques{% endblock %}

{% block body %}
<div class="row">
    <!-- Cartes Statistiques -->
    <div class="col-lg-3 col-md-6 mb-4">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4 class="mb-0">{{ totalProduits }}</h4>
                        <p class="mb-0">Total Produits</p>
                    </div>
                    <div class="align-self-center">
                        <i class="bi bi-box" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 mb-4">
        <div class="card bg-success text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4 class="mb-0">{{ totalCommandes }}</h4>
                        <p class="mb-0">Total Commandes</p>
                    </div>
                    <div class="align-self-center">
                        <i class="bi bi-receipt" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 mb-4">
        <div class="card bg-info text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4 class="mb-0">{{ totalVentes|number_format(2, ',', ' ') }} DT</h4>
                        <p class="mb-0">Total Ventes</p>
                    </div>
                    <div class="align-self-center">
                        <i class="bi bi-currency-euro" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 mb-4">
        <div class="card bg-warning text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4 class="mb-0">{{ produitsEnStock }}</h4>
                        <p class="mb-0">Produits en Stock</p>
                    </div>
                    <div class="align-self-center">
                        <i class="bi bi-archive" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <!-- Produits Plus Vendus -->
    <div class="col-lg-8 mb-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-trophy me-2"></i>Top 5 Produits Plus Vendus
                </h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead class="table-light">
                            <tr>
                                <th>Produit</th>
                                <th class="text-center">Quantité Vendue</th>
                                <th class="text-end">Total Ventes</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for produit in produitsPlusVendus %}
                                <tr>
                                    <td><strong>{{ produit.nom }}</strong></td>
                                    <td class="text-center">
                                        <span class="badge bg-primary">{{ produit.totalVendu }}</span>
                                    </td>
                                    <td class="text-end">
                                        <span class="text-success fw-bold">{{ produit.totalVentes|number_format(2, ',', ' ') }} DT</span>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Alertes -->
    <div class="col-lg-4 mb-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-exclamation-triangle me-2"></i>Alertes
                </h5>
            </div>
            <div class="card-body">
                {% if produitsEnRupture|length > 0 %}
                    <div class="alert alert-danger">
                        <h6 class="alert-heading">
                            <i class="bi bi-x-circle me-2"></i>Produits en Rupture de Stock
                        </h6>
                        <ul class="mb-0">
                            {% for produit in produitsEnRupture %}
                                <li>{{ produit.nom }}</li>
                            {% endfor %}
                        </ul>
                        <hr>
                        <small class="text-muted">
                            Total: {{ produitsEnRupture|length }} produit(s) concerné(s)
                        </small>
                    </div>
                {% else %}
                    <div class="alert alert-success">
                        <i class="bi bi-check-circle me-2"></i>
                        <strong>Tous les produits sont en stock!</strong>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <!-- Chiffre d'Affaires Mensuel -->
    <div class="col-lg-8 mb-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-graph-up me-2"></i>Chiffre d'Affaires Mensuel
                </h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th class="text-end">Chiffre d'Affaires</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for mois in chiffreAffairesMensuel %}
                                <tr>
                                    <td>
                                        {{ mois.dateCommande|date('F Y') }}
                                    </td>
                                    <td class="text-end">
                                        <span class="fw-bold text-success">{{ mois.chiffreAffaires|number_format(2, ',', ' ') }} DT</span>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Commandes Récentes -->
    <div class="col-lg-4 mb-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-clock-history me-2"></i>Commandes Récentes
                </h5>
            </div>
            <div class="card-body">
                {% for commande in commandesRecentes %}
                    <div class="border-bottom pb-2 mb-2">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <strong>{{ commande.reference }}</strong>
                                <br>
                                <small class="text-muted">{{ commande.dateCommande|date('d/m/Y H:i') }}</small>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-success">{{ commande.total|number_format(2, ',', ' ') }} DT</span>
                                <br>
                                <small class="text-muted">{{ commande.statut }}</small>
                            </div>
                        </div>
                    </div>
                {% endfor %}
                
                {% if commandesRecentes is empty %}
                    <p class="text-muted text-center">Aucune commande récente</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
