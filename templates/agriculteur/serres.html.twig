{% extends 'agriculteur/base.html.twig' %}

{% block title %}Mes Serres - Espace Agriculteur{% endblock %}

{% block content %}
<div class="container-fluid">
    <!-- Page Header -->
    <div class="page-header">
        <h1>🏠 Mes Serres</h1>
        <p>Gérez vos serres et leurs zones</p>
        <div class="mt-3">
            <a href="{{ path('app_agriculteur_serre_new') }}" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i>
                Créer une Nouvelle Serre
            </a>
        </div>
    </div>

    <!-- Flash Messages -->
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <!-- Filters Section -->
    <div class="filter-section">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <label for="search" class="form-label">🔍 Recherche</label>
                <input type="text" 
                       id="search" 
                       name="search" 
                       class="form-control" 
                       value="{{ search }}"
                       placeholder="Nom ou localisation">
            </div>
            <div class="col-md-3">
                <label for="etat" class="form-label">📊 État</label>
                <select id="etat" name="etat" class="form-control">
                    <option value="">Tous les états</option>
                    <option value="actif" {{ etat == 'actif' ? 'selected' : '' }}>Actif</option>
                    <option value="maintenance" {{ etat == 'maintenance' ? 'selected' : '' }}>Maintenance</option>
                    <option value="inactive" {{ etat == 'inactive' ? 'selected' : '' }}>Inactif</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="sort" class="form-label">🔄 Tri</label>
                <select id="sort" name="sort" class="form-control">
                    <option value="nom" {{ sortBy == 'nom' ? 'selected' : '' }}>Nom (A-Z)</option>
                    <option value="surface" {{ sortBy == 'surface' ? 'selected' : '' }}>Surface (décroissant)</option>
                    <option value="date" {{ sortBy == 'date' ? 'selected' : '' }}>Date (récent)</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel"></i>
                    Filtrer
                </button>
            </div>
        </form>
    </div>

    <!-- Serres List -->
    <div class="content-card">
        <div class="card-header">
            <h5>📋 Liste des Serres</h5>
        </div>
        <div class="table-container">
            <table class="table">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Localisation</th>
                        <th>Surface</th>
                        <th>État</th>
                        <th>Date Mise en Service</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% if serres|length > 0 %}
                        {% for serre in serres %}
                            <tr>
                                <td>
                                    <strong>{{ serre.nomSerre }}</strong>
                                </td>
                                <td>
                                    <i class="bi bi-geo-alt text-muted"></i>
                                    {{ serre.localisation }}
                                </td>
                                <td>
                                    <span class="badge bg-info">{{ serre.surface }} m²</span>
                                </td>
                                <td>
                                    <span class="badge bg-{{ serre.etatSerre == 'actif' ? 'success' : serre.etatSerre == 'maintenance' ? 'warning' : 'secondary' }}">
                                        {{ serre.etatSerre|title }}
                                    </span>
                                </td>
                                <td>
                                    {% if serre.dateMiseEnService %}
                                        {{ serre.dateMiseEnService|date('d/m/Y') }}
                                    {% else %}
                                        <span class="text-muted">Non définie</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="{{ path('app_agriculteur_serre_details', {'id': serre.id}) }}" 
                                           class="btn btn-sm btn-primary" title="Voir les détails">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="{{ path('app_agriculteur_serre_edit', {'id': serre.id}) }}" 
                                           class="btn btn-sm btn-outline-primary" title="Modifier">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a href="{{ path('app_agriculteur_zone_new') }}?serre={{ serre.id }}" 
                                           class="btn btn-sm btn-success" title="Ajouter une zone">
                                            <i class="bi bi-plus"></i>
                                        </a>
                                        <button type="button" 
                                                class="btn btn-sm btn-outline-danger" 
                                                onclick="confirmDeleteSerre({{ serre.id }}, '{{ serre.nomSerre }}')"
                                                title="Supprimer">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <i class="bi bi-house-slash" style="font-size: 2rem; color: #ccc;"></i>
                                <h5 class="mt-3">Aucune serre trouvée</h5>
                                <p class="text-muted">
                                    {% if search or etat %}
                                        Essayez de modifier vos filtres de recherche
                                    {% else %}
                                        Commencez par créer votre première serre
                                    {% endif %}
                                </p>
                                {% if not search and not etat %}
                                    <a href="{{ path('app_agriculteur_serre_new') }}" class="btn btn-primary">
                                        <i class="bi bi-plus-lg"></i>
                                        Créer une Serre
                                    </a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Statistics -->
    {% if serres|length > 0 %}
        <div class="row mt-4">
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="number">{{ serres|length }}</div>
                    <div class="label">🏠 Total Serres</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="number">{{ serres|filter(s => s.etatSerre == 'actif')|length }}</div>
                    <div class="label">✅ Actives</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="number">{{ serres|filter(s => s.etatSerre == 'maintenance')|length }}</div>
                    <div class="label">🔧 Maintenance</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="number">{{ serres|reduce((sum, s) => sum + s.surface, 0) }} m²</div>
                    <div class="label">📐 Surface Totale</div>
                </div>
            </div>
        </div>
    {% endif %}
</div>

<!-- JavaScript -->
<script>
function confirmDeleteSerre(serreId, serreName) {
    if (confirm(`Êtes-vous sûr de vouloir supprimer la serre "${serreName}" ? Cette action est irréversible.`)) {
        window.location.href = `/agriculteur/serre/${serreId}/delete`;
    }
}
</script>
{% endblock %}
