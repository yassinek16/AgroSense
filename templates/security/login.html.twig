{% extends 'base.html.twig' %}

{% block title %}Sign In - Smart Greenhouse{% endblock %}

{% block body %}
<style>
    .login-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background: linear-gradient(135deg, #2D6A4F 0%, #40916C 100%);
        padding: 20px;
    }

    .login-box {
        background: white;
        border-radius: 12px;
        box-shadow: 0 10px 40px rgba(45, 106, 79, 0.2);
        padding: 40px;
        width: 100%;
        max-width: 400px;
    }

    .login-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .login-header .logo {
        max-width: 80px;
        margin-bottom: 20px;
    }

    .login-header h1 {
        color: #2D6A4F;
        font-size: 28px;
        font-weight: 700;
        margin: 0 0 10px 0;
    }

    .login-header .subtitle {
        color: #666;
        font-size: 14px;
        margin: 0;
    }

    .login-form {
        margin-top: 30px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        font-weight: 600;
        color: #333;
        margin-bottom: 8px;
        font-size: 14px;
    }

    .form-group input[type="email"],
    .form-group input[type="password"] {
        width: 100%;
        padding: 12px;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 14px;
        transition: border-color 0.3s;
    }

    .form-group input[type="email"]:focus,
    .form-group input[type="password"]:focus {
        outline: none;
        border-color: #40916C;
        box-shadow: 0 0 0 3px rgba(64, 145, 108, 0.1);
    }

    .form-check {
        display: flex;
        align-items: center;
        margin-bottom: 20px;
    }

    .form-check input[type="checkbox"] {
        width: 18px;
        height: 18px;
        margin-right: 8px;
        cursor: pointer;
        accent-color: #40916C;
    }

    .form-check label {
        margin: 0;
        font-weight: 400;
        color: #666;
        font-size: 14px;
        cursor: pointer;
    }

    .btn-success {
        width: 100%;
        padding: 12px;
        background-color: #2D6A4F;
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.3s;
        margin-top: 10px;
    }

    .btn-success:hover {
        background-color: #1b4332;
    }

    .btn-lg {
        padding: 14px 20px;
        font-size: 16px;
    }

    .btn-block {
        display: block;
        width: 100%;
    }

    .alert {
        padding: 12px 15px;
        border-radius: 6px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .alert-danger {
        background-color: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    .alert-success {
        background-color: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }

    .signup-link {
        text-align: center;
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid #eee;
    }

    .signup-link a {
        color: #40916C;
        text-decoration: none;
        font-weight: 600;
        transition: color 0.3s;
    }

    .signup-link a:hover {
        color: #2D6A4F;
    }

    .forgot-password {
        text-align: right;
        margin-bottom: 20px;
    }

    .forgot-password a {
        color: #40916C;
        text-decoration: none;
        font-size: 14px;
        transition: color 0.3s;
    }

    .forgot-password a:hover {
        color: #2D6A4F;
    }

    .user-logged-in {
        background-color: #d4edda;
        color: #155724;
        padding: 12px 15px;
        border-radius: 6px;
        margin-bottom: 20px;
        font-size: 14px;
        border: 1px solid #c3e6cb;
    }

    .user-logged-in a {
        color: #155724;
        text-decoration: underline;
        font-weight: 600;
    }

    .user-logged-in a:hover {
        color: #0c3622;
    }
</style>

<div class="login-container">
    <div class="login-box">
        <!-- Logo -->
        <div class="login-header">
            <img src="{{ asset('images/logo.png') }}" alt="Smart Greenhouse" class="logo">
            <h1>Sign In</h1>
            <p class="subtitle">Access your Smart Greenhouse account</p>
        </div>

        <!-- Error Messages -->
        {% if error %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <!-- Already Logged In -->
        {% if app.user %}
            <div class="user-logged-in">
                You are logged in as <strong>{{ app.user.userIdentifier }}</strong>
                <br><a href="{{ path('app_logout') }}">Logout</a>
            </div>
        {% endif %}

        <!-- Login Form -->
        <form method="post" class="login-form" novalidate>
            <!-- Email -->
            <div class="form-group">
                <label for="inputEmail">Email Address</label>
                <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" autocomplete="email" required autofocus>
            </div>

            <!-- Password -->
            <div class="form-group">
                <label for="inputPassword">Password</label>
                <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required>
            </div>

            <!-- Remember Me -->
            <div class="form-check">
                <input type="checkbox" name="_remember_me" id="rememberMe">
                <label for="rememberMe">Remember me</label>
            </div>

            <!-- CSRF Token -->
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <!-- Submit Button -->
            <button class="btn btn-success btn-lg btn-block" type="submit">
                Sign In
            </button>
        </form>

        <!-- Sign Up Link -->
        <div class="signup-link">
            Don't have an account? <a href="{{ path('app_register') }}">Create Account</a>
        </div>
    </div>
</div>
{% endblock %}
