{% extends 'base.html.twig' %}

{% block title %}Acheter un billet - {{ evenement.titre }}{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-cart-plus"></i> Achat de billet
                    </h4>
                </div>
                <div class="card-body">
                    <!-- Event Summary -->
                    <div class="mb-4 p-3 bg-light rounded">
                        <h5 class="text-success">{{ evenement.titre }}</h5>
                        <div class="row">
                            <div class="col-md-6">
                                <small class="text-muted d-block">
                                    <i class="bi bi-calendar-event"></i> {{ evenement.dateDebut|date('d/m/Y à H:i') }}
                                </small>
                                <small class="text-muted d-block">
                                    <i class="bi bi-geo-alt"></i> {{ evenement.lieu }}
                                </small>
                            </div>
                            <div class="col-md-6 text-md-end">
                                <h3 class="text-primary mb-0">{{ evenement.ticketPrice }} TND</h3>
                                <small class="text-muted">Prix du billet</small>
                            </div>
                        </div>
                    </div>

                    <!-- Purchase Form -->
                    <form method="post">
                        <h6 class="mb-3">Informations de l'acheteur</h6>
                        
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Nom complet</label>
                                <input type="text" class="form-control" value="{{ app.user.fullName }}" readonly>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Email</label>
                                <input type="email" class="form-control" value="{{ app.user.email }}" readonly>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Méthode de paiement</label>
                            <select name="payment_method" class="form-select" required>
                                <option value="">Sélectionnez une méthode</option>
                                <option value="cash">Espèces (sur place)</option>
                                <option value="card">Carte bancaire</option>
                                <option value="mobile">Paiement mobile</option>
                                <option value="transfer">Virement bancaire</option>
                            </select>
                        </div>

                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> 
                            <strong>Note:</strong> Ceci est une simulation. Dans un système réel, vous seriez redirigé vers une passerelle de paiement sécurisée.
                        </div>

                        <!-- Summary -->
                        <div class="border-top pt-3 mt-4">
                            <h6 class="mb-3">Récapitulatif de la commande</h6>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Prix du billet</span>
                                <strong>{{ evenement.ticketPrice }} TND</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Frais de service</span>
                                <strong>0.00 TND</strong>
                            </div>
                            <hr>
                            <div class="d-flex justify-content-between">
                                <h5>Total</h5>
                                <h5 class="text-success">{{ evenement.ticketPrice }} TND</h5>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a href="{{ path('evenement_show', {id: evenement.id}) }}" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Retour
                            </a>
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-check-circle"></i> Confirmer l'achat
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
