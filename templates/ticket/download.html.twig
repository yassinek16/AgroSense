{% extends 'base.html.twig' %}

{% block title %}Télécharger Billet {{ ticket.referenceTicket }}{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Printable Ticket -->
            <div id="printable-ticket" class="card shadow-lg border-0">
                <div class="card-header bg-success text-white text-center py-4">
                    <h2 class="mb-0">
                        <i class="bi bi-flower1"></i> SMART GREENHOUSE
                    </h2>
                    <h4 class="mt-2">BILLET D'ENTRÉE</h4>
                </div>
                
                <div class="card-body p-5">
                    <!-- Event Title -->
                    <div class="text-center mb-4">
                        <h3 class="text-success mb-2">{{ ticket.evenement.titre }}</h3>
                        <p class="text-muted h5">{{ ticket.evenement.typeEvenement|capitalize }}</p>
                    </div>

                    <!-- Divider -->
                    <div class="border-top border-bottom border-2 border-success py-3 mb-4">
                        <div class="row text-center">
                            <div class="col-6">
                                <div class="mb-2">
                                    <i class="bi bi-calendar-event text-success" style="font-size: 2rem;"></i>
                                </div>
                                <strong>{{ ticket.evenement.dateDebut|date('d/m/Y') }}</strong>
                                <br>
                                <small class="text-muted">{{ ticket.evenement.dateDebut|date('H:i') }}</small>
                            </div>
                            <div class="col-6">
                                <div class="mb-2">
                                    <i class="bi bi-geo-alt-fill text-danger" style="font-size: 2rem;"></i>
                                </div>
                                <strong>{{ ticket.evenement.lieu }}</strong>
                            </div>
                        </div>
                    </div>

                    <!-- Ticket Details -->
                    <div class="row mb-4">
                        <div class="col-6 mb-3">
                            <h6 class="text-muted mb-1 small">RÉFÉRENCE BILLET</h6>
                            <p class="h5 font-monospace mb-0">{{ ticket.referenceTicket }}</p>
                        </div>
                        <div class="col-6 mb-3">
                            <h6 class="text-muted mb-1 small">NOM DU PARTICIPANT</h6>
                            <p class="h5 mb-0">{{ ticket.user.fullName }}</p>
                        </div>
                        <div class="col-6 mb-3">
                            <h6 class="text-muted mb-1 small">EMAIL</h6>
                            <p class="mb-0">{{ ticket.user.email }}</p>
                        </div>
                        <div class="col-6 mb-3">
                            <h6 class="text-muted mb-1 small">PRIX PAYÉ</h6>
                            <p class="h4 text-success mb-0">{{ ticket.prixPaye }} TND</p>
                        </div>
                    </div>

                    <!-- QR Code -->
                    <div class="text-center mb-4 py-4 bg-light rounded">
                        <div style="width: 200px; height: 200px; margin: 0 auto; background: white; border: 3px solid #333; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-qr-code" style="font-size: 180px; color: #333;"></i>
                        </div>
                        <p class="text-muted mt-3 mb-0 small">
                            Scannez ce code à l'entrée de l'événement
                        </p>
                    </div>

                    <!-- Event Description -->
                    <div class="border-top pt-3">
                        <h6 class="text-muted mb-2">À PROPOS DE L'ÉVÉNEMENT</h6>
                        <p class="small">{{ ticket.evenement.description|slice(0, 300) }}...</p>
                    </div>

                    <!-- Important Notes -->
                    <div class="alert alert-warning mt-3 mb-0">
                        <h6 class="alert-heading">
                            <i class="bi bi-exclamation-triangle"></i> Informations importantes
                        </h6>
                        <ul class="mb-0 small">
                            <li>Ce billet est personnel et non transférable</li>
                            <li>Présentez-vous 15 minutes avant le début de l'événement</li>
                            <li>Ce billet doit être présenté à l'entrée (version imprimée ou numérique)</li>
                            <li>En cas de problème, contactez-nous avec votre référence de billet</li>
                        </ul>
                    </div>
                </div>
                
                <div class="card-footer text-center text-muted py-3">
                    <small>
                        Billet émis le {{ ticket.dateAchat|date('d/m/Y à H:i') }}
                        <br>
                        Smart Greenhouse Event Management System
                    </small>
                </div>
            </div>

            <!-- Action Buttons (not printed) -->
            <div class="mt-4 no-print">
                <div class="d-flex justify-content-between">
                    <a href="{{ path('ticket_show', {id: ticket.id}) }}" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Retour
                    </a>
                    <div class="btn-group">
                        <button onclick="window.print()" class="btn btn-primary">
                            <i class="bi bi-printer"></i> Imprimer
                        </button>
                        <button onclick="downloadAsPDF()" class="btn btn-success">
                            <i class="bi bi-file-pdf"></i> Télécharger PDF
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @media print {
        .no-print {
            display: none !important;
        }
        
        body {
            background: white;
        }
        
        .container {
            max-width: 100%;
        }
        
        .card {
            box-shadow: none !important;
            border: 2px solid #333 !important;
        }
    }
</style>

<script>
    function downloadAsPDF() {
        // This would require a PDF generation library
        // For now, we'll just trigger print
        alert('Pour télécharger en PDF, utilisez la fonction "Imprimer" de votre navigateur et sélectionnez "Enregistrer au format PDF"');
        window.print();
    }
</script>
{% endblock %}
