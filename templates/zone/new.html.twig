{% extends 'base.html.twig' %}

{% block title %}Créer une zone{% endblock %}

{% block body %}
    <div class="animate-fade-in">
        <div class="page-header">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_zone_index') }}">Accueil</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Nouvelle zone</li>
                </ol>
            </nav>
            <h1 class="page-title">Créer une nouvelle zone</h1>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="bi bi-clipboard-plus me-2 text-success"></i>Informations de la zone
                        </h5>
                    </div>
                    <div class="card-body">
                        {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}

                        {# Affichage des erreurs globales #}
                        {% if form_errors(form) %}
                            <div class="alert alert-danger d-flex align-items-center mb-4">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                {{ form_errors(form) }}
                            </div>
                        {% endif %}

                        <div class="row g-4">
                            {# Nom de la zone #}
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(form.nomZone, 'Nom de la zone', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">
                                            <i class="bi bi-tag text-muted"></i>
                                        </span>
                                        {{ form_widget(form.nomZone, {'attr': {
                                            'class': 'form-control form-control-lg' ~ (form.nomZone.vars.errors|length > 0 ? ' is-invalid' : ''),
                                            'placeholder': 'Ex: Zone A1'
                                        }}) }}
                                    </div>
                                    {{ form_errors(form.nomZone) }}
                                </div>
                            </div>

                            {# Type de zone #}
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(form.typeZone, 'Type de zone', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">
                                            <i class="bi bi-list text-muted"></i>
                                        </span>
                                        {{ form_widget(form.typeZone, {'attr': {
                                            'class': 'form-select form-select-lg' ~ (form.typeZone.vars.errors|length > 0 ? ' is-invalid' : '')
                                        }}) }}
                                    </div>
                                    {{ form_errors(form.typeZone) }}
                                </div>
                            </div>

                            {# Surface de la zone #}
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(form.superficie, 'Surface (m²)', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">
                                            <i class="bi bi-arrows-angle-expand text-muted"></i>
                                        </span>
                                        {{ form_widget(form.superficie, {'attr': {
                                            'class': 'form-control form-control-lg' ~ (form.superficie.vars.errors|length > 0 ? ' is-invalid' : ''),
                                            'placeholder': 'Ex: 100'
                                        }}) }}
                                        <span class="input-group-text">m²</span>
                                    </div>
                                    {{ form_errors(form.superficie) }}
                                </div>
                            </div>

                            {# État de la zone #}
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(form.etatZone, 'État de la zone', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">
                                            <i class="bi bi-activity text-muted"></i>
                                        </span>
                                        {{ form_widget(form.etatZone, {'attr': {
                                            'class': 'form-select form-select-lg' ~ (form.etatZone.vars.errors|length > 0 ? ' is-invalid' : '')
                                        }}) }}
                                    </div>
                                    {{ form_errors(form.etatZone) }}
                                </div>
                            </div>

                            {# Culture associée #}
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(form.cultureAssociee, 'Culture associée', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                                    {{ form_widget(form.cultureAssociee, {'attr': {
                                        'class': 'form-control form-control-lg' ~ (form.cultureAssociee.vars.errors|length > 0 ? ' is-invalid' : ''),
                                        'placeholder': 'Ex: Tomates'
                                    }}) }}
                                    {{ form_errors(form.cultureAssociee) }}
                                </div>
                            </div>

                            {# Serre #}
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(form.serre, 'Serre associée', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                                    {{ form_widget(form.serre, {'attr': {
                                        'class': 'form-control form-control-lg' ~ (form.serre.vars.errors|length > 0 ? ' is-invalid' : '')
                                    }}) }}
                                    {{ form_errors(form.serre) }}
                                </div>
                            </div>

                        </div>

                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                            <button type="submit" class="btn btn-success mt-3">
                                <i class="bi bi-check-lg me-2"></i> Enregistrer la zone
                            </button>
                        </div>

                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
