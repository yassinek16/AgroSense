{% extends 'base.html.twig' %}

{% block title %}Boutique - AgriCulture{% endblock %}

{% block body %}
<!-- Hero Section -->
<section class="hero-section agricultural-pattern">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold text-white mb-4">
                    <i class="bi bi-flower2 me-3"></i>Bienvenue chez AgriCulture
                </h1>
                <p class="lead text-white mb-4">
                    Découvrez notre sélection de produits agricoles frais et de qualité, 
                    cultivés avec passion et respect de la nature.
                </p>
            </div>
            <div class="col-lg-6">
                <div class="text-center">
                    <i class="bi bi-basket" style="font-size: 8rem; color: rgba(255,255,255,0.3);"></i>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Products Section -->
<section class="py-5">
    <div class="container">
        <!-- Search Bar -->
        <div class="row mb-4">
            <div class="col-lg-6 mx-auto">
                <form method="GET" action="{{ path('app_front_index') }}" class="d-flex">
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" 
                               name="search" 
                               value="{{ searchTerm }}" 
                               class="form-control" 
                               placeholder="Rechercher des produits par nom ou description...">
                        <button class="btn btn-primary" type="submit">
                            Rechercher
                        </button>
                    </div>
                </form>
                <small class="form-text text-muted text-center d-block mt-2">
                    Entrez au moins 2 caractères pour rechercher
                </small>
                {% if searchTerm %}
                    <div class="mt-2 text-center">
                        <span class="badge bg-info">
                            Résultats pour: "{{ searchTerm }}"
                        </span>
                        <a href="{{ path('app_front_index') }}" class="btn btn-sm btn-outline-secondary ms-2">
                            <i class="bi bi-x-circle"></i> Effacer
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold">
                {% if searchTerm %}
                    Résultats de recherche
                {% else %}
                    Nos Produits
                {% endif %}
            </h2>
            <p class="lead text-muted">
                {% if searchTerm %}
                    Produits correspondant à "{{ searchTerm }}"
                {% else %}
                    Des produits frais directement de la ferme à votre table
                {% endif %}
            </p>
        </div>

        <div class="row g-4">
            {% for produit in produits %}
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100">
                        <!-- Product Image -->
                        {% if produit.image %}
                            <img src="{{ asset('uploads/images/' ~ produit.image) }}" 
                                 class="card-img-top" 
                                 alt="{{ produit.nom }}"
                                 style="height: 200px; object-fit: cover;">
                        {% else %}
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" 
                                 style="height: 200px;">
                                <i class="bi bi-image" style="font-size: 3rem; color: #ccc;"></i>
                            </div>
                        {% endif %}

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">{{ produit.nom }}</h5>
                            <p class="card-text text-muted flex-grow-1">
                                {{ produit.description|slice(0, 100) }}{% if produit.description|length > 100 %}...{% endif %}
                            </p>
                            
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="h4 text-success mb-0">{{ produit.prix }} DT</span>
                                <small class="text-muted">
                                    <i class="bi bi-box-seam"></i> 
                                    Stock: {{ produit.quantiteStock }}
                                </small>
                            </div>

                            {% if produit.quantiteStock > 0 %}
                                <form action="{{ path('app_cart_add', {'id': produit.id}) }}" method="POST">
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="bi bi-cart-plus me-2"></i>Ajouter au panier
                                    </button>
                                </form>
                            {% else %}
                                <button class="btn btn-secondary w-100" disabled>
                                    <i class="bi bi-x-circle me-2"></i>Rupture de stock
                                </button>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% else %}
                {% if searchTerm %}
                    <div class="col-12 text-center py-5">
                        <i class="bi bi-search" style="font-size: 4rem; color: #ccc;"></i>
                        <h3 class="mt-3 text-muted">Aucun produit trouvé pour "{{ searchTerm }}"</h3>
                        <p class="text-muted">Essayez avec d'autres mots-clés ou <a href="{{ path('app_front_index') }}">affichez tous les produits</a>.</p>
                    </div>
                {% else %}
                    <div class="col-12 text-center py-5">
                        <i class="bi bi-inbox" style="font-size: 4rem; color: #ccc;"></i>
                        <h3 class="mt-3 text-muted">Aucun produit disponible</h3>
                        <p class="text-muted">Revenez bientôt pour découvrir nos nouveaux produits!</p>
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</section>

<!-- Serres Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold">
                <i class="bi bi-building me-3" style="color: #28a745;"></i>Nos Serres Actives
            </h2>
            <p class="lead text-muted">
                Découvrez nos installation modernes de culture en serre
            </p>
        </div>

        <div class="row g-4">
            {% for serre in serres %}
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm hover-shadow border-0" style="transition: all 0.3s ease; border-left: 5px solid #28a745;">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-gradient rounded-circle p-3" style="width: 70px; height: 70px; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #28a745 0%, #20c997 100%);">
                                    <i class="bi bi-building text-white" style="font-size: 2rem;"></i>
                                </div>
                                <div class="ms-3 flex-grow-1">
                                    <h5 class="card-title mb-0 text-dark fw-bold">{{ serre.nomSerre }}</h5>
                                    <small class="text-muted">
                                        <i class="bi bi-geo-alt-fill me-1"></i>{{ serre.localisation }}
                                    </small>
                                </div>
                            </div>

                            <div class="card-text flex-grow-1">
                                <div class="mb-3">
                                    <span class="badge bg-success me-2" style="font-size: 0.85rem; padding: 0.5rem 0.75rem;">
                                        <i class="bi bi-check-circle me-1"></i>Actif
                                    </span>
                                    <small class="text-muted">
                                        <i class="bi bi-calendar me-1"></i>{{ serre.dateMiseEnService|date('d M Y') }}
                                    </small>
                                </div>
                                
                                <div class="row g-2 text-center mb-3">
                                    <div class="col-6">
                                        <div class="bg-light p-2 rounded-3">
                                            <small class="d-block text-muted">Surface</small>
                                            <strong class="text-success">{{ serre.surface }}m²</strong>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="bg-light p-2 rounded-3">
                                            <small class="d-block text-muted">Zones</small>
                                            <strong class="text-info">{{ serre.zones|length }}</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <a href="{{ path('app_front_serre_detail', {'id': serre.id}) }}" class="btn btn-success w-100 mt-2" style="border-radius: 0.5rem;">
                                <i class="bi bi-arrow-right me-2"></i>Voir les détails
                            </a>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center py-5">
                    <i class="bi bi-inbox" style="font-size: 4rem; color: #ddd;"></i>
                    <h3 class="mt-3 text-muted">Aucune serre active</h3>
                    <p class="text-muted small">Les serres seront affichées ici une fois activées</p>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

<!-- Zones Section -->
<section class="py-5 bg-light bg-gradient">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold">
                <i class="bi bi-geo-alt me-3" style="color: #17a2b8;"></i>Zones de Culture
            </h2>
            <p class="lead text-muted">
                Découvrez nos zones de culture organisées et productives
            </p>
        </div>

        <div class="row g-4">
            {% for zone in zones %}
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm hover-shadow border-0" style="transition: all 0.3s ease; border-left: 5px solid #17a2b8;">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-gradient rounded-circle p-3" style="width: 70px; height: 70px; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #17a2b8 0%, #20c997 100%);">
                                    <i class="bi bi-leaf text-white" style="font-size: 2rem;"></i>
                                </div>
                                <div class="ms-3 flex-grow-1">
                                    <h5 class="card-title mb-0 text-dark fw-bold">{{ zone.nomZone }}</h5>
                                    <small class="text-muted">{{ zone.typeZone }}</small>
                                </div>
                            </div>

                            <div class="card-text flex-grow-1">
                                <div class="mb-3">
                                    <span class="badge bg-info me-2" style="font-size: 0.85rem; padding: 0.5rem 0.75rem;">
                                        <i class="bi bi-check-circle me-1"></i>Active
                                    </span>
                                </div>
                                
                                <div class="row g-2 text-center mb-3">
                                    <div class="col-6">
                                        <div class="bg-light p-2 rounded-3">
                                            <small class="d-block text-muted">Culture</small>
                                            <strong class="text-info" style="font-size: 0.9rem;">{{ zone.cultureAssociee }}</strong>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="bg-light p-2 rounded-3">
                                            <small class="d-block text-muted">Superficie</small>
                                            <strong class="text-success">{{ zone.superficie }}m²</strong>
                                        </div>
                                    </div>
                                </div>

                                {% if zone.serre %}
                                    <div class="alert alert-light small mb-2 border-left border-info" role="alert" style="border-left-width: 3px;">
                                        <i class="bi bi-building me-1 text-info"></i>
                                        Serre: <strong>{{ zone.serre.nomSerre }}</strong>
                                    </div>
                                {% endif %}
                            </div>

                            <a href="{{ path('app_front_zone_detail', {'id': zone.id}) }}" class="btn btn-info w-100 mt-2" style="border-radius: 0.5rem; color: white;">
                                <i class="bi bi-arrow-right me-2"></i>Voir les détails
                            </a>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center py-5">
                    <i class="bi bi-inbox" style="font-size: 4rem; color: #ddd;"></i>
                    <h3 class="mt-3 text-muted">Aucune zone active</h3>
                    <p class="text-muted small">Les zones seront affichées ici une fois activées</p>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

{% endblock %}