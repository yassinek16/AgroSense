{% extends 'base.html.twig' %}

{% block title %}Détails de la Serre : {{ serre.nomSerre }}{% endblock %}

{% block body %}
<div class="container mt-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb bg-transparent p-0">
            <li class="breadcrumb-item"><a href="{{ path('app_serre_index') }}" class="text-success">Serres</a></li>
            <li class="breadcrumb-item active" aria-current="page">Détails</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2"><i class="fas fa-leaf text-success me-2"></i>Détails de la Serre</h1>
        <div>
            <a href="{{ path('app_serre_index') }}" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left"></i> Retour
            </a>
            <a href="{{ path('app_serre_edit', {'id': serre.id}) }}" class="btn btn-warning btn-sm text-white">
                <i class="fas fa-edit"></i> Modifier
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom-0 pt-4">
                    <h5 class="card-title mb-0 text-muted">Informations Générales</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless align-middle">
                        <tbody>
                            <tr>
                                <th class="text-muted fw-normal">Nom de la Serre</th>
                                <td class="fw-bold">{{ serre.nomSerre }}</td>
                            </tr>
                            <tr>
                                <th class="text-muted fw-normal">Localisation</th>
                                <td><span class="badge bg-light text-dark border"><i class="fas fa-map-marker-alt text-danger me-1"></i> {{ serre.localisation }}</span></td>
                            </tr>
                            <tr>
                                <th class="text-muted fw-normal">Surface</th>
                                <td><span class="h5 mb-0 text-success">{{ serre.surface }} m²</span></td>
                            </tr>
                            <tr>
                                <th class="text-muted fw-normal">Configuration</th>
                                <td>
                                    <span class="badge bg-info-subtle text-info border border-info">
                                        <i class="fas fa-th-large me-1"></i> {{ serre.zones|length }} Zone(s) enregistrée(s)
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <th class="text-muted fw-normal">État actuel</th>
                                <td>
                                    {% if serre.etatSerre == 'culturelle' %}
                                        <span class="badge bg-success-subtle text-success border border-success">En culture</span>
                                    {% elseif serre.etatSerre == 'maintenance' %}
                                        <span class="badge bg-warning-subtle text-warning border border-warning">Maintenance</span>
                                    {% else %}
                                        <span class="badge bg-secondary">{{ serre.etatSerre }}</span>
                                    {% endif %}
                                </td>
                            </tr>
                            <tr>
                                <th class="text-muted fw-normal">Mise en service</th>
                                <td>{{ serre.dateMiseEnService ? serre.dateMiseEnService|date('d/m/Y') : 'N/A' }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h6 class="card-title text-muted mb-3">Navigation Rapide</h6>
                    <a href="{{ path('app_zone_by_serre', {'serre_id': serre.id}) }}" class="btn btn-success w-100 mb-2 py-2">
    <i class="fas fa-search-location me-2"></i> Voir les Zones de cette serre
</a>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4 
                {% if serre.etatSerre == 'culturelle' %}bg-success text-white
                {% elseif serre.etatSerre == 'maintenance' %}bg-warning text-dark
                {% else %}bg-secondary text-white{% endif %}">
                <div class="card-body text-center py-4">
                    <i class="fas {% if serre.etatSerre == 'culturelle' %}fa-seedling{% elseif serre.etatSerre == 'maintenance' %}fa-tools{% else %}fa-pause-circle{% endif %} fa-3x mb-3"></i>
                    <h4>{{ serre.etatSerre|capitalize }}</h4>
                    <p class="small opacity-75">Statut mis à jour d'après les capteurs AgroSerre.</p>
                </div>
            </div>

           
        </div>
    </div>
</div>
{% endblock %}