  <header id="header" class="header d-flex align-items-center position-relative">
    <div class="container-fluid container-xl position-relative d-flex align-items-center justify-content-between">

      <a href="{{ path('home') }}" class="logo d-flex align-items-center">
        <img src="{{ asset('assets/img/logo.png') }}" alt="Smart Greenhouse">
      </a>

      <nav id="navmenu" class="navmenu">
        <ul>
          <li><a href="{{ path('home') }}" class="active">Home</a></li>
          <li><a href="{{ path('about') }}">About Us</a></li>
          <li><a href="{{ path('services') }}">Our Services</a></li>
          <li><a href="{{ path('testimonials') }}">Testimonials</a></li>
          <li><a href="{{ path('blog') }}">Blog</a></li>
          <li><a href="{{ path('contact') }}">Contact</a></li>

          {% if app.user %}
            <li class="dropdown"><a href="#"><span>Account</span> <i class="bi bi-chevron-down toggle-dropdown"></i></a>
              <ul>
                <li><a href="{{ path('app_admin') }}">Dashboard</a></li>
                <li><a href="{{ path('app_logout') }}">Logout</a></li>
              </ul>
            </li>
          {% else %}
            <li><a href="{{ path('app_login') }}" class="nav-auth-link">Login</a></li>
            <li><a href="{{ path('app_register') }}" class="nav-auth-link btn-signup">Sign Up</a></li>
          {% endif %}
