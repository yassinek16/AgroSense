{% extends 'admin/base.html.twig' %}

{% block title %}Users Management - Admin Dashboard{% endblock %}

{% block page_title %}
    <div>
        <h1 class="page-title">Users Management</h1>
        <p style="color: #6b7280; margin: 0; font-weight: normal;">Manage your user base</p>
    </div>
{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title">All Users</h5>
                    <div class="d-flex gap-2 align-items-center">
                        <span style="color: #6b7280; font-size: 0.875rem;">Total: <strong>{{ totalItems }}</strong></span>
                        <a href="{{ path('app_admin_user_create') }}" class="btn btn-sm btn-primary">
                            <i class="bi bi-plus-lg"></i> Add User
                        </a>
                    </div>
                </div>

                <div class="card-body p-0">
                    {% if users %}
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>
                                            <a href="?sort=firstName&order={% if currentSort == 'firstName' and currentOrder == 'ASC' %}DESC{% else %}ASC{% endif %}" style="color: inherit; text-decoration: none;">
                                                User
                                                {% if currentSort == 'firstName' %}
                                                    <i class="bi bi-arrow-{% if currentOrder == 'ASC' %}up{% else %}down{% endif %}"></i>
                                                {% endif %}
                                            </a>
                                        </th>
                                        <th>
                                            <a href="?sort=email&order={% if currentSort == 'email' and currentOrder == 'ASC' %}DESC{% else %}ASC{% endif %}" style="color: inherit; text-decoration: none;">
                                                Email
                                                {% if currentSort == 'email' %}
                                                    <i class="bi bi-arrow-{% if currentOrder == 'ASC' %}up{% else %}down{% endif %}"></i>
                                                {% endif %}
                                            </a>
                                        </th>
                                        <th>
                                            <a href="?sort=roles&order={% if currentSort == 'roles' and currentOrder == 'ASC' %}DESC{% else %}ASC{% endif %}" style="color: inherit; text-decoration: none;">
                                                Role
                                                {% if currentSort == 'roles' %}
                                                    <i class="bi bi-arrow-{% if currentOrder == 'ASC' %}up{% else %}down{% endif %}"></i>
                                                {% endif %}
                                            </a>
                                        </th>
                                        <th>
                                            <a href="?sort=statutCompte&order={% if currentSort == 'statutCompte' and currentOrder == 'ASC' %}DESC{% else %}ASC{% endif %}" style="color: inherit; text-decoration: none;">
                                                Status
                                                {% if currentSort == 'statutCompte' %}
                                                    <i class="bi bi-arrow-{% if currentOrder == 'ASC' %}up{% else %}down{% endif %}"></i>
                                                {% endif %}
                                            </a>
                                        </th>
                                        <th>
                                            <a href="?sort=subscriptionStatus&order={% if currentSort == 'subscriptionStatus' and currentOrder == 'ASC' %}DESC{% else %}ASC{% endif %}" style="color: inherit; text-decoration: none;">
                                                Subscription
                                                {% if currentSort == 'subscriptionStatus' %}
                                                    <i class="bi bi-arrow-{% if currentOrder == 'ASC' %}up{% else %}down{% endif %}"></i>
                                                {% endif %}
                                            </a>
                                        </th>
                                        <th>
                                            <a href="?sort=dateCreation&order={% if currentSort == 'dateCreation' and currentOrder == 'ASC' %}DESC{% else %}ASC{% endif %}" style="color: inherit; text-decoration: none;">
                                                Joined
                                                {% if currentSort == 'dateCreation' %}
                                                    <i class="bi bi-arrow-{% if currentOrder == 'ASC' %}up{% else %}down{% endif %}"></i>
                                                {% endif %}
                                            </a>
                                        </th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for user in users %}
                                        <tr>
                                            <td>
                                                <div class="user-cell">
                                                    <div class="avatar" style="width: 36px; height: 36px; font-size: 0.75rem;">{{ user.initials }}</div>
                                                    <div>
                                                        <div style="font-weight: 500; color: #1f2937;">{{ user.fullName }}</div>
                                                        <div style="font-size: 0.875rem; color: #6b7280;">{{ user.email }}</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span style="color: #6b7280;">{{ user.email }}</span>
                                            </td>
                                            <td>
                                                {% set roles = user.roles %}
                                                {% if 'ROLE_ADMIN' in roles %}
                                                    <span class="badge" style="background: #dbeafe; color: #1e40af;">Administrator</span>
                                                {% elseif 'ROLE_TECHNICIEN' in roles %}
                                                    <span class="badge" style="background: #fef08a; color: #713f12;">Technicien</span>
                                                {% elseif 'ROLE_AGRICULTOR' in roles %}
                                                    <span class="badge" style="background: #e0e7ff; color: #3730a3;">Agricultor</span>
                                                {% else %}
                                                    <span class="badge" style="background: #e0e7ff; color: #3730a3;">User</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                <span class="badge {% if user.statutCompte == 'active' %}bg-success{% elseif user.statutCompte == 'away' %}bg-warning{% elseif user.statutCompte == 'offline' %}bg-secondary{% elseif user.statutCompte == 'suspended' %}bg-danger{% else %}bg-light text-dark{% endif %}">
                                                    {% if user.statutCompte == 'active' %}
                                                        ● Active
                                                    {% elseif user.statutCompte == 'away' %}
                                                        ● Away
                                                    {% elseif user.statutCompte == 'offline' %}
                                                        ● Offline
                                                    {% elseif user.statutCompte == 'suspended' %}
                                                        ● Suspended
                                                    {% else %}
                                                        ● Unknown
                                                    {% endif %}
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge {% if user.subscriptionStatus == 'active' %}bg-success{% elseif user.subscriptionStatus == 'expired' %}bg-danger{% else %}bg-light text-dark{% endif %}">
                                                    {% if user.subscriptionStatus == 'active' %}
                                                        ● Active
                                                    {% elseif user.subscriptionStatus == 'expired' %}
                                                        ● Expired
                                                    {% else %}
                                                        ● None
                                                    {% endif %}
                                                </span>
                                            </td>
                                            <td>
                                                {% if user.dateCreation %}
                                                    <span style="color: #6b7280;">{{ user.dateCreation|date('M d, Y') }}</span>
                                                {% else %}
                                                    <span style="color: #9ca3af;">—</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                <a href="{{ path('app_admin_user_edit', { id: user.id }) }}" class="btn btn-sm" style="background: #e0e7ff; color: #3730a3;">
                                                    <i class="bi bi-pencil"></i> Edit
                                                </a>
                                                <form method="POST" action="{{ path('app_admin_user_delete', { id: user.id }) }}" style="display: inline;" onsubmit="return confirmDelete('{{ user.fullName|escape('js') }}');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                                    <button type="submit" class="btn btn-sm btn-danger">
                                                        <i class="bi bi-trash"></i> Delete
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div style="padding: 40px; text-align: center; color: #6b7280;">
                            <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.5; display: block; margin-bottom: 10px;"></i>
                            <p>No users found.</p>
                        </div>
                    {% endif %}
                </div>

                {% if totalPages > 1 %}
                    <div class="card-footer bg-white border-top">
                        <nav aria-label="Page navigation">
                            <ul class="pagination justify-content-end mb-0">
                                {% if currentPage > 1 %}
                                    <li class="page-item">
                                        <a class="page-link" href="?page=1&sort={{ currentSort }}&order={{ currentOrder }}"><i class="bi bi-chevron-double-left"></i></a>
                                    </li>
                                    <li class="page-item">
                                        <a class="page-link" href="?page={{ currentPage - 1 }}&sort={{ currentSort }}&order={{ currentOrder }}"><i class="bi bi-chevron-left"></i></a>
                                    </li>
                                {% endif %}

                                {% for page in 1..totalPages %}
                                    {% if page == currentPage %}
                                        <li class="page-item"><span class="page-link active">{{ page }}</span></li>
                                    {% elseif page >= currentPage - 2 and page <= currentPage + 2 %}
                                        <li class="page-item"><a class="page-link" href="?page={{ page }}&sort={{ currentSort }}&order={{ currentOrder }}">{{ page }}</a></li>
                                    {% elseif page == currentPage - 3 or page == currentPage + 3 %}
                                        <li class="page-item"><span class="page-link">...</span></li>
                                    {% endif %}
                                {% endfor %}

                                {% if currentPage < totalPages %}
                                    <li class="page-item">
                                        <a class="page-link" href="?page={{ currentPage + 1 }}&sort={{ currentSort }}&order={{ currentOrder }}"><i class="bi bi-chevron-right"></i></a>
                                    </li>
                                    <li class="page-item">
                                        <a class="page-link" href="?page={{ totalPages }}&sort={{ currentSort }}&order={{ currentOrder }}"><i class="bi bi-chevron-double-right"></i></a>
                                    </li>
                                {% endif %}
                            </ul>
                        </nav>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
