{% extends 'admin/base.html.twig' %}

{% block title %}Edit User - Admin Dashboard{% endblock %}

{% block page_title %}
    <div>
        <a href="{{ path('app_admin_user_index') }}" style="color: #10b981; text-decoration: none;">
            <i class="bi bi-arrow-left"></i> Back to Users
        </a>
        <h1 class="page-title" style="margin-top: 10px;">Edit User</h1>
    </div>
{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">User Information</h5>
                </div>

                <div class="card-body">
                    <form method="POST" novalidate>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(form.firstName, 'First Name') }}
                                    {{ form_widget(form.firstName) }}
                                    {% if form.firstName.vars.errors %}
                                        <small class="text-danger d-block mt-2">
                                            {% for error in form.firstName.vars.errors %}
                                                {{ error.message }}
                                            {% endfor %}
                                        </small>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(form.lastName, 'Last Name') }}
                                    {{ form_widget(form.lastName) }}
                                    {% if form.lastName.vars.errors %}
                                        <small class="text-danger d-block mt-2">
                                            {% for error in form.lastName.vars.errors %}
                                                {{ error.message }}
                                            {% endfor %}
                                        </small>
                                    {% endif %}
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            {{ form_label(form.email, 'Email Address') }}
                            {{ form_widget(form.email) }}
                            {% if form.email.vars.errors %}
                                <small class="text-danger d-block mt-2">
                                    {% for error in form.email.vars.errors %}
                                        {{ error.message }}
                                    {% endfor %}
                                </small>
                            {% endif %}
                        </div>

                        <div class="form-group">
                            {{ form_label(form.roles, 'Role') }}
                            <div style="color: #6b7280; font-size: 0.875rem; margin-bottom: 8px;">
                                Select one or more roles for this user.
                            </div>
                            {{ form_widget(form.roles) }}
                            {% if form.roles.vars.errors %}
                                <small class="text-danger d-block mt-2">
                                    {% for error in form.roles.vars.errors %}
                                        {{ error.message }}
                                    {% endfor %}
                                </small>
                            {% endif %}
                        </div>

                        <div class="form-group">
                            {{ form_label(form.statutCompte, 'Account Status') }}
                            {{ form_widget(form.statutCompte) }}
                            {% if form.statutCompte.vars.errors %}
                                <small class="text-danger d-block mt-2">
                                    {% for error in form.statutCompte.vars.errors %}
                                        {{ error.message }}
                                    {% endfor %}
                                </small>
                            {% endif %}
                        </div>

                        <div class="form-group">
                            {{ form_label(form.subscriptionStatus, 'Subscription Status') }}
                            {{ form_widget(form.subscriptionStatus) }}
                            {% if form.subscriptionStatus.vars.errors %}
                                <small class="text-danger d-block mt-2">
                                    {% for error in form.subscriptionStatus.vars.errors %}
                                        {{ error.message }}
                                    {% endfor %}
                                </small>
                            {% endif %}
                        </div>

                        <div class="form-group">
                            <div class="form-check">
                                {{ form_widget(form.isVerified) }}
                                {{ form_label(form.isVerified, 'Email Verified') }}
                            </div>
                            <small style="color: #6b7280; display: block; margin-top: 6px;">
                                Check this if the user has verified their email address.
                            </small>
                        </div>

                        <div class="d-flex gap-3 mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg"></i> Save Changes
                            </button>
                            <a href="{{ path('app_admin_user_index') }}" class="btn" style="background: #e5e7eb; color: #374151;">
                                <i class="bi bi-x-lg"></i> Cancel
                            </a>
                        </div>

                        {{ form_rest(form) }}
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- User Profile Card -->
            <div class="card mb-3">
                <div class="card-body" style="text-align: center; padding: 30px 20px;">
                    <div class="avatar" style="width: 80px; height: 80px; font-size: 2rem; margin: 0 auto 15px;">{{ user.initials }}</div>
                    <h5 style="margin: 0; color: #1f2937;">{{ user.fullName }}</h5>
                    <p style="color: #6b7280; margin: 5px 0 0 0; font-size: 0.875rem;">{{ user.email }}</p>
                </div>
            </div>

            <!-- User Details Card -->
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">Account Details</h5>
                </div>
                <div class="card-body" style="padding: 0;">
                    <div style="padding: 12px; border-bottom: 1px solid #e5e7eb;">
                        <small style="color: #6b7280; display: block;">Member Since</small>
                        <strong style="color: #1f2937;">
                            {% if user.dateCreation %}
                                {{ user.dateCreation|date('F d, Y') }}
                            {% else %}
                                —
                            {% endif %}
                        </strong>
                    </div>
                    <div style="padding: 12px; border-bottom: 1px solid #e5e7eb;">
                        <small style="color: #6b7280; display: block;">Email Verified</small>
                        <strong style="color: #1f2937;">
                            {% if user.isVerified %}
                                <span class="badge bg-success">✓ Yes</span>
                            {% else %}
                                <span class="badge bg-danger">✗ No</span>
                            {% endif %}
                        </strong>
                    </div>
                    <div style="padding: 12px;">
                        <small style="color: #6b7280; display: block;">Current Role</small>
                        <strong style="color: #1f2937;">
                            {% set roles = user.roles %}
                            {% if 'ROLE_ADMIN' in roles %}
                                <span class="badge" style="background: #dbeafe; color: #1e40af;">Administrator</span>
                            {% elseif 'ROLE_EDITOR' in roles %}
                                <span class="badge" style="background: #fef08a; color: #713f12;">Editor</span>
                            {% else %}
                                <span class="badge" style="background: #e0e7ff; color: #3730a3;">User</span>
                            {% endif %}
                        </strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
