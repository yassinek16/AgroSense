{% extends 'admin/base.html.twig' %}

{% block title %}Create New User - Admin Dashboard{% endblock %}

{% block page_title %}
    <div>
        <a href="{{ path('app_admin_user_index') }}" style="color: #10b981; text-decoration: none;">
            <i class="bi bi-arrow-left"></i> Back to Users
        </a>
        <h1 class="page-title" style="margin-top: 10px;">Create New User</h1>
    </div>
{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">User Information</h5>
                </div>

                <div class="card-body">
                    <form method="POST" novalidate>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(form.firstName, 'First Name') }}
                                    {{ form_widget(form.firstName) }}
                                    {% if form.firstName.vars.errors %}
                                        <small class="text-danger d-block mt-2">
                                            {% for error in form.firstName.vars.errors %}
                                                {{ error.message }}
                                            {% endfor %}
                                        </small>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(form.lastName, 'Last Name') }}
                                    {{ form_widget(form.lastName) }}
                                    {% if form.lastName.vars.errors %}
                                        <small class="text-danger d-block mt-2">
                                            {% for error in form.lastName.vars.errors %}
                                                {{ error.message }}
                                            {% endfor %}
                                        </small>
                                    {% endif %}
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            {{ form_label(form.email, 'Email Address') }}
                            {{ form_widget(form.email) }}
                            {% if form.email.vars.errors %}
                                <small class="text-danger d-block mt-2">
                                    {% for error in form.email.vars.errors %}
                                        {{ error.message }}
                                    {% endfor %}
                                </small>
                            {% endif %}
                        </div>

                        <div class="form-group">
                            {{ form_label(form.password, 'Password') }}
                            {{ form_widget(form.password) }}
                            {% if form.password.vars.errors %}
                                <small class="text-danger d-block mt-2">
                                    {% for error in form.password.vars.errors %}
                                        {{ error.message }}
                                    {% endfor %}
                                </small>
                            {% endif %}
                            <small style="color: #6b7280; display: block; margin-top: 6px;">
                                Password must be at least 6 characters long.
                            </small>
                        </div>

                        <div class="form-group">
                            {{ form_label(form.roles, 'Role') }}
                            <div style="color: #6b7280; font-size: 0.875rem; margin-bottom: 8px;">
                                Select one or more roles for this user.
                            </div>
                            {{ form_widget(form.roles) }}
                            {% if form.roles.vars.errors %}
                                <small class="text-danger d-block mt-2">
                                    {% for error in form.roles.vars.errors %}
                                        {{ error.message }}
                                    {% endfor %}
                                </small>
                            {% endif %}
                        </div>

                        <div class="form-group">
                            {{ form_label(form.statutCompte, 'Account Status') }}
                            {{ form_widget(form.statutCompte) }}
                            {% if form.statutCompte.vars.errors %}
                                <small class="text-danger d-block mt-2">
                                    {% for error in form.statutCompte.vars.errors %}
                                        {{ error.message }}
                                    {% endfor %}
                                </small>
                            {% endif %}
                        </div>

                        <div class="form-group">
                            {{ form_label(form.subscriptionStatus, 'Subscription Status') }}
                            {{ form_widget(form.subscriptionStatus) }}
                            {% if form.subscriptionStatus.vars.errors %}
                                <small class="text-danger d-block mt-2">
                                    {% for error in form.subscriptionStatus.vars.errors %}
                                        {{ error.message }}
                                    {% endfor %}
                                </small>
                            {% endif %}
                        </div>

                        <div class="form-group">
                            <div class="form-check">
                                {{ form_widget(form.isVerified) }}
                                {{ form_label(form.isVerified, 'Email Verified') }}
                            </div>
                            <small style="color: #6b7280; display: block; margin-top: 6px;">
                                Check this if the user has verified their email address.
                            </small>
                        </div>

                        <div class="d-flex gap-3 mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-plus-lg"></i> Create User
                            </button>
                            <a href="{{ path('app_admin_user_index') }}" class="btn" style="background: #e5e7eb; color: #374151;">
                                <i class="bi bi-x-lg"></i> Cancel
                            </a>
                        </div>

                        {{ form_rest(form) }}
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Information Card -->
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">
                        <i class="bi bi-info-circle"></i> Information
                    </h5>
                </div>
                <div class="card-body" style="padding: 0;">
                    <div style="padding: 15px; border-bottom: 1px solid #e5e7eb;">
                        <small style="color: #6b7280; display: block; margin-bottom: 8px;"><strong>Required Fields</strong></small>
                        <ul style="margin: 0; padding-left: 20px; font-size: 0.875rem; color: #6b7280;">
                            <li>Email Address</li>
                            <li>Password</li>
                            <li>Role(s)</li>
                        </ul>
                    </div>
                    <div style="padding: 15px; border-bottom: 1px solid #e5e7eb;">
                        <small style="color: #6b7280; display: block; margin-bottom: 8px;"><strong>Optional Fields</strong></small>
                        <ul style="margin: 0; padding-left: 20px; font-size: 0.875rem; color: #6b7280;">
                            <li>First Name</li>
                            <li>Last Name</li>
                            <li>Account Status</li>
                            <li>Subscription Status</li>
                            <li>Email Verified</li>
                        </ul>
                    </div>
                    <div style="padding: 15px;">
                        <small style="color: #6b7280; display: block; margin-bottom: 8px;"><strong>Role Descriptions</strong></small>
                        <div style="font-size: 0.875rem; color: #6b7280;">
                            <strong style="color: #1f2937;">Agricultor:</strong> Farm user access<br>
                            <strong style="color: #1f2937;">Technicien:</strong> Technical support role<br>
                            <strong style="color: #1f2937;">Admin:</strong> Full administrative access
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
