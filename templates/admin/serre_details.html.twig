{% extends 'admin/base_admin.html.twig' %}

{% block title %}Détails de la Serre - Administration{% endblock %}

{% block content %}
<div class="container-fluid">
    <!-- Page Header -->
    <div class="page-header">
        <h1>🏠 Détails de la Serre</h1>
        <p>Consultation des informations de la serre</p>
        <div class="mt-3">
            <a href="{{ path('app_admin_serres') }}" class="btn btn-outline-primary">
                <i class="bi bi-arrow-left"></i>
                Retour à la supervision
            </a>
        </div>
    </div>

    <!-- Flash Messages -->
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <!-- Serre Details -->
    <div class="content-card mb-4">
        <div class="card-header">
            <h5>📋 Informations de la Serre</h5>
        </div>
        <div class="p-4">
            <div class="row">
                <div class="col-md-6">
                    <div class="detail-item">
                        <label class="detail-label">Nom de la serre</label>
                        <div class="detail-value">{{ serre.nomSerre }}</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="detail-item">
                        <label class="detail-label">Localisation</label>
                        <div class="detail-value">
                            <i class="bi bi-geo-alt"></i>
                            {{ serre.localisation }}
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="detail-item">
                        <label class="detail-label">Surface totale</label>
                        <div class="detail-value">
                            <span class="badge bg-info">{{ serre.surface }} m²</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="detail-item">
                        <label class="detail-label">État actuel</label>
                        <div class="detail-value">
                            <span class="badge bg-{{ serre.etatSerre == 'actif' ? 'success' : serre.etatSerre == 'maintenance' ? 'warning' : 'secondary' }}">
                                {{ serre.etatSerre|title }}
                            </span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="detail-item">
                        <label class="detail-label">Date de mise en service</label>
                        <div class="detail-value">
                            {% if serre.dateMiseEnService %}
                                {{ serre.dateMiseEnService|date('d/m/Y') }}
                            {% else %}
                                <span class="text-muted">Non définie</span>
                            {% endif %}
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="detail-item">
                        <label class="detail-label">Nombre de zones</label>
                        <div class="detail-value">
                            <span class="badge bg-primary">{{ serre.zones|length }}</span>
                            {% if serre.zones|length > 5 %}
                                <small class="text-warning">
                                    <i class="bi bi-exclamation-triangle"></i>
                                    Beaucoup de zones
                                </small>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Zones de la Serre -->
    <div class="content-card mb-4">
        <div class="card-header">
            <h5>📏 Zones de cette Serre</h5>
            <small class="text-muted">{{ serre.zones|length }} zone(s) trouvée(s)</small>
        </div>
        <div class="table-container">
            <table class="table">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Type</th>
                        <th>Superficie</th>
                        <th>Culture</th>
                        <th>État</th>
                       
                    </tr>
                </thead>
                <tbody>
                    {% for zone in serre.zones %}
                        <tr>
                            <td>
                                <strong>{{ zone.nomZone }}</strong>
                            </td>
                            <td>
                                <span class="badge bg-secondary">{{ zone.typeZone|title }}</span>
                            </td>
                            <td>
                                <span class="badge bg-info">{{ zone.superficie }} m²</span>
                            </td>
                            <td>
                                {% if zone.cultureAssociee %}
                                    {{ zone.cultureAssociee }}
                                {% else %}
                                    <span class="text-muted">Aucune</span>
                                {% endif %}
                            </td>
                            <td>
                                <span class="badge bg-{{ zone.etatZone == 'active' ? 'success' : 'secondary' }}">
                                    {{ zone.etatZone|title }}
                                </span>
                            </td>
                            
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-muted">
                                <i class="bi bi-grid-3x3" style="font-size: 2rem;"></i>
                                <p>Aucune zone trouvée pour cette serre</p>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Statistiques de la Serre -->
    <div class="content-card mb-4">
        <div class="card-header">
            <h5>📊 Statistiques de la Serre</h5>
        </div>
        <div class="p-4">
            <div class="row">
                <div class="col-md-4">
                    <div class="stat-item">
                        <div class="stat-number">{{ serre.zones|length }}</div>
                        <div class="stat-label">Total Zones</div>
                    </div>
                </div>
                <div class="col-md-4">
                    {% set surfaceUtilisee = serre.zones|reduce((sum, zone) => sum + zone.superficie, 0) %}
                    {% set surfaceRestante = serre.surface - surfaceUtilisee %}
                    <div class="stat-item">
                        <div class="stat-number">{{ surfaceUtilisee }} m²</div>
                        <div class="stat-label">Surface Utilisée</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="stat-item">
                        <div class="stat-number">{{ surfaceRestante }} m²</div>
                        <div class="stat-label">Surface Restante</div>
                    </div>
                </div>
            </div>
            
            {% if surfaceRestante < 0 %}
                <div class="alert alert-danger mt-3">
                    <i class="bi bi-exclamation-triangle"></i>
                    <strong>Incohérence détectée :</strong> La surface totale des zones ({{ surfaceUtilisee }} m²) dépasse la surface de la serre ({{ serre.surface }} m²).
                </div>
            {% elseif surfaceRestante == 0 %}
                <div class="alert alert-success mt-3">
                    <i class="bi bi-check-circle"></i>
                    <strong>Optimisation parfaite :</strong> Toute la surface de la serre est utilisée.
                </div>
            {% else %}
                <div class="alert alert-info mt-3">
                    <i class="bi bi-info-circle"></i>
                    <strong>Surface disponible :</strong> {{ surfaceRestante }} m² restants ({{ ((surfaceRestante / serre.surface) * 100)|round(1) }}%).
                </div>
            {% endif %}
        </div>
    </div>
</div>

<style>
.detail-item {
    margin-bottom: 1.5rem;
}

.detail-label {
    font-weight: 600;
    color: var(--muted);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: block;
    margin-bottom: 0.5rem;
}

.detail-value {
    font-size: 1.1rem;
    color: var(--dark);
}

.stat-item {
    text-align: center;
    padding: 1rem;
    background: var(--bg-light);
    border-radius: 8px;
}

.stat-number {
    font-size: 1.5rem;
    font-weight: bold;
    color: var(--primary);
}

.stat-label {
    font-size: 0.9rem;
    color: var(--muted);
    margin-top: 0.5rem;
}
</style>
{% endblock %}
