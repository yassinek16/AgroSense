{% extends 'base.html.twig' %}

{% block title %}Dashboard Admin - Smart Greenhouse{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <h1 class="mb-4 text-success">
        <i class="bi bi-speedometer2"></i> Dashboard Administrateur
    </h1>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm h-100 bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase mb-1 opacity-75">Événements Total</h6>
                            <h2 class="mb-0">{{ eventStats.total }}</h2>
                        </div>
                        <i class="bi bi-calendar-event" style="font-size: 3rem; opacity: 0.3;"></i>
                    </div>
                    <div class="mt-2 small">
                        <i class="bi bi-arrow-up"></i> {{ eventStats.upcoming }} à venir
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm h-100 bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase mb-1 opacity-75">Billets Vendus</h6>
                            <h2 class="mb-0">{{ ticketStats.confirmed }}</h2>
                        </div>
                        <i class="bi bi-ticket-perforated" style="font-size: 3rem; opacity: 0.3;"></i>
                    </div>
                    <div class="mt-2 small">
                        <i class="bi bi-hourglass-split"></i> {{ ticketStats.pending }} en attente
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm h-100 bg-warning text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase mb-1 opacity-75">Revenus Total</h6>
                            <h2 class="mb-0">{{ totalRevenue|number_format(2) }} TND</h2>
                        </div>
                        <i class="bi bi-currency-dollar" style="font-size: 3rem; opacity: 0.3;"></i>
                    </div>
                    <div class="mt-2 small">
                        <i class="bi bi-calendar-month"></i> {{ monthRevenue|number_format(2) }} TND ce mois
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm h-100 bg-info text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase mb-1 opacity-75">Utilisateurs</h6>
                            <h2 class="mb-0">{{ totalUsers }}</h2>
                        </div>
                        <i class="bi bi-people" style="font-size: 3rem; opacity: 0.3;"></i>
                    </div>
                    <div class="mt-2 small">
                        <i class="bi bi-person-check"></i> Membres inscrits
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Popular Events -->
        <div class="col-lg-8 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        <i class="bi bi-fire"></i> Événements Populaires
                    </h5>
                </div>
                <div class="card-body">
                    {% if popularEvents is empty %}
                        <p class="text-muted text-center py-4">Aucun événement populaire pour le moment</p>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Événement</th>
                                        <th>Date</th>
                                        <th class="text-center">Billets</th>
                                        <th class="text-end">Revenus</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for event in popularEvents %}
                                        <tr>
                                            <td>
                                                <strong>{{ event.titre }}</strong>
                                                <br>
                                                <small class="text-muted">{{ event.typeEvenement|capitalize }}</small>
                                            </td>
                                            <td>{{ event.dateDebut|date('d/m/Y') }}</td>
                                            <td class="text-center">
                                                <span class="badge bg-success">{{ event.ticketsSold }}</span>
                                                {% if event.capaciteMax %}
                                                    / {{ event.capaciteMax }}
                                                {% endif %}
                                            </td>
                                            <td class="text-end">
                                                <strong>{{ event.totalRevenue|number_format(2) }} TND</strong>
                                            </td>
                                            <td>
                                                <a href="{{ path('evenement_statistics', {id: event.id}) }}" class="btn btn-sm btn-outline-info">
                                                    <i class="bi bi-graph-up"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Recent Tickets -->
        <div class="col-lg-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        <i class="bi bi-clock-history"></i> Billets Récents
                    </h5>
                </div>
                <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                    {% if recentTickets is empty %}
                        <p class="text-muted text-center py-4">Aucun billet récent</p>
                    {% else %}
                        {% for ticket in recentTickets %}
                            <div class="d-flex align-items-start mb-3 pb-3 {% if not loop.last %}border-bottom{% endif %}">
                                <div class="flex-grow-1">
                                    <strong class="d-block">{{ ticket.user.fullName }}</strong>
                                    <small class="text-muted d-block">{{ ticket.evenement.titre }}</small>
                                    <small class="text-muted">
                                        <i class="bi bi-clock"></i> {{ ticket.dateAchat|date('d/m H:i') }}
                                    </small>
                                </div>
                                <span class="badge {% if ticket.isConfirmed %}bg-success{% else %}bg-warning{% endif %}">
                                    {{ ticket.prixPaye }} TND
                                </span>
                            </div>
                        {% endfor %}
                    {% endif %}
                </div>
                <div class="card-footer bg-white">
                    <a href="{{ path('admin_tickets') }}" class="btn btn-sm btn-outline-primary w-100">
                        Voir tous les billets
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3">
                        <i class="bi bi-lightning"></i> Actions Rapides
                    </h5>
                    <div class="row">
                        <div class="col-md-3 mb-2">
                            <a href="{{ path('evenement_new') }}" class="btn btn-success w-100">
                                <i class="bi bi-plus-circle"></i> Créer un événement
                            </a>
                        </div>
                        <div class="col-md-3 mb-2">
                            <a href="{{ path('evenement_index') }}" class="btn btn-primary w-100">
                                <i class="bi bi-calendar-event"></i> Gérer les événements
                            </a>
                        </div>
                        <div class="col-md-3 mb-2">
                            <a href="{{ path('admin_users') }}" class="btn btn-info w-100">
                                <i class="bi bi-people"></i> Gérer les utilisateurs
                            </a>
                        </div>
                        <div class="col-md-3 mb-2">
                            <a href="{{ path('admin_reports') }}" class="btn btn-warning w-100">
                                <i class="bi bi-file-bar-graph"></i> Voir les rapports
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
