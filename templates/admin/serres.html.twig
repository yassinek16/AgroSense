{% extends 'admin/base.html.twig' %}

{% block title %}Serres - Administration{% endblock %}

{% block admin_content %}
<div class="admin-header">
    <div class="d-flex justify-content-between align-items-center">
        <h1>🏠 Gestion des Serres</h1>
        <a href="{{ path('app_admin_serres_new') }}" class="btn-admin">
            <i class="bi bi-plus-lg"></i>
            Nouvelle Serre
        </a>
    </div>
</div>

<div class="table-container">
    <div class="table-header">
        <div class="row">
            <div class="col">Nom</div>
            <div class="col">Localisation</div>
            <div class="col">Surface</div>
            <div class="col">État</div>
            <div class="col">Date Mise en Service</div>
            <div class="col">Actions</div>
        </div>
    </div>

    <div class="table-body">
        {% for serre in serres %}
            <div class="activity-item">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <strong>{{ serre.nomSerre }}</strong>
                        <div class="text-muted small">{{ serre.localisation }}</div>
                    </div>
                    <div>
                        <span class="badge bg-info">{{ serre.surface }} m²</span>
                    </div>
                    <div>
                        <span class="badge bg-{{ serre.etatSerre == 'actif' ? 'success' : 'secondary' }}">
                            {{ serre.etatSerre|capitalize }}
                        </span>
                    </div>
                    <div>
                        <small class="text-muted">
                            {{ serre.dateMiseEnService ? serre.dateMiseEnService|date('d/m/Y') : 'Non définie' }}
                        </small>
                    </div>
                    <div>
                        <a href="{{ path('app_admin_edit_serre', {'id': serre.id}) }}" class="btn-admin btn-sm">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a href="{{ path('app_admin_delete_serre', {'id': serre.id}) }}" 
                           class="btn-admin btn-sm btn-danger"
                           onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette serre ?')">
                            <i class="bi bi-trash"></i>
                        </a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="text-center text-muted py-5">
                Aucune serre trouvée
            </div>
        {% endfor %}
    </div>
</div>

<div class="mt-4">
    <h5>📊 Statistiques des Serres</h5>
    <div class="stats-grid">
        <div class="stat-card">
            <h3>📏 Total</h3>
            <div class="number">{{ serres|length }}</div>
            <div class="label">Serres</div>
        </div>
        <div class="stat-card">
            <h3>✅ Actives</h3>
            <div class="number">{{ serres|filter(s => s.etatSerre == 'actif')|length }}</div>
            <div class="label">Actives</div>
        </div>
        <div class="stat-card">
            <h3>📏 Surface Totale</h3>
            <div class="number">{{ serres|reduce((sum, s) => sum + s.surface, 0) }} m²</div>
            <div class="label">m²</div>
        </div>
    </div>
</div>
{% endblock %}
